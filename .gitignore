# ============================================================
# realestate-channel — .gitignore
# ============================================================

# Environment & secrets — NEVER commit these
.env
*.env.*
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
*.egg
.pytest_cache/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs & temp
*.log
*.tmp
/tmp/
.cache/

# Generated content (lives in Google Drive, not git)
/content/
/analytics/
/.data/

# API response caches
.cache/
*.json.cache

# Call store (sqlite + artifacts) when BASE_CONTENT_DIR is unset
.data/
